{
    "name": "drawdy-aurora",
    "version": "1.0.0",
    "description": "Aurora for Drawdy: a slow WebGL aurora drifts across your whole board while you draw.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "vite",
        "build": "node build.ts",
        "test": "tsx --test test/*.test.ts",
        "typecheck": "tsc --noEmit",
        "preflight": "node scripts/preflight.mjs"
    },
    "devDependencies": {
        "@drawdy/driver-protocol": "1.3.0",
        "@rollup/plugin-typescript": "^12.1.2",
        "@tailwindcss/cli": "4.3.3",
        "@types/node": "^24",
        "fflate": "^0.8.2",
        "rollup": "^4.34.0",
        "tailwindcss": "4.3.3",
        "tslib": "^2.8.1",
        "tsx": "^4.20.0",
        "typescript": "^5",
        "vite": "^8.2.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "esbuild"
        ]
